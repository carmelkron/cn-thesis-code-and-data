{
  "name": "Monitoring Target Tweets",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// 1. Setup today's date (midnight)\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0);\n\n// 2. Create \"Today\" string in YYYY-MM-DD format\n// We build this manually to ensure it uses the local server time, not UTC\nconst yyyy = today.getFullYear();\nconst mm = String(today.getMonth() + 1).padStart(2, '0'); // Months are 0-indexed\nconst dd = String(today.getDate()).padStart(2, '0');\nconst todayStr = `${yyyy}-${mm}-${dd}`;\n\n// 3. Create a Set to track URLs we have already added (for deduplication)\nconst seenUrls = new Set();\nconst returnItems = [];\n\n// 4. Loop through all items\nfor (const item of items) {\n  const data = item.json;\n  const dateStr = data[\"Start_Date (Creation)\"];\n  const url = data[\"URL\"];\n\n  // --- A. Date Filter Logic ---\n  if (!dateStr) continue; \n\n  const rowDate = new Date(dateStr);\n  if (isNaN(rowDate.getTime())) continue; \n  \n  rowDate.setHours(0, 0, 0, 0);\n\n  const diffTime = today - rowDate;\n  const diffDays = diffTime / (1000 * 60 * 60 * 24);\n\n  // REJECTION LOGIC:\n  // If diffDays is LESS than 1 (meaning 0, i.e., today)... SKIP.\n  // OR if diffDays is GREATER than 13... SKIP.\n  // This leaves only days 1 through 13.\n  if (diffDays < 1 || diffDays > 13) continue;\n\n  // --- B. Deduplication Logic ---\n  if (seenUrls.has(url)) continue;\n  seenUrls.add(url);\n\n  // --- C. Construct Output ---\n  returnItems.push({\n    json: {\n      \"Group\": data[\"Group\"],\n      \"URL\": data[\"URL\"],\n      \"Start_Date (Creation)\": data[\"Start_Date (Creation)\"],\n      \"Sample_Date\": todayStr\n    }\n  });\n}\n\nreturn returnItems;"
      },
